{
  "name": "symbiote-agui",
  "version": "0.6.1",
  "description": "Local interactive interfaces for AI agents, built with Symbiote.js.",
  "license": "MIT",
  "keywords": [
    "agui",
    "generative-ui",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "webmcp",
    "symbiote",
    "web-components",
    "tailwindcss",
    "jsda-kit",
    "cli"
  ],
  "type": "module",
  "bin": {
    "symbiote-agui": "./bin/symbiote-agui.js"
  },
  "files": [
    "bin/",
    "docs/",
    "src/",
    "types/",
    "skills/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnd-pro/symbiote-agui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node ./bin/symbiote-agui.js",
    "types": "tsc --project tsconfig.json && tsc --project tsconfig.browser.json",
    "test:node": "node --test tests/node/*.test.js",
    "test:package": "node --test tests/node/package-smoke.js",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.js",
    "test": "npm run test:node && npm run test:browser",
    "prepublishOnly": "npm run types && npm run test:node"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "puppeteer-core": "^25.14.0",
    "typescript": "^7.0.2"
  },
  "author": {
    "email": "team@rnd-pro.com",
    "name": "RND-PRO.com",
    "url": "https://rnd-pro.com/"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@symbiotejs/symbiote": "^3.8.3",
    "@tailwindcss/node": "^4.3.3",
    "jsda-kit": "1.6.4",
    "linkedom": "^0.18.13",
    "tailwindcss": "^4.3.3",
    "ws": "^8.22.0"
  }
}
