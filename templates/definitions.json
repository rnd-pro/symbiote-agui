{
  "label": { "type": "string", "minLength": 1, "maxLength": 256 },
  "texts": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 2048 } },
  "routes": {
    "type": "object",
    "minProperties": 1,
    "maxProperties": 32,
    "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "additionalProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "src"],
      "properties": {
        "title": { "$ref": "#/$defs/label" },
        "src": { "type": "string", "maxLength": 1024, "pattern": "^\\./_assets/.+\\.html?$" },
        "icon": { "type": "string", "maxLength": 64 },
        "default": { "type": "boolean" }
      }
    }
  }
}
