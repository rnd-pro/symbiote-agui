{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2024",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "linkedom": [
        "./types/linkedom.d.ts"
      ],
      "@tailwindcss/node": [
        "./types/tailwindcss-node.d.ts"
      ]
    },
    "types": [
      "node"
    ],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "bin/**/*.js",
    "src/**/*.js",
    "types/**/*.d.ts",
    "tests/node/**/*.js",
    "tests/browser/**/*.js"
  ],
  "exclude": [
    "src/manager/page/**/*.js",
    "src/page/client/**/*.js"
  ]
}
